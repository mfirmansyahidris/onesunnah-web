rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /hadiths/{id} {
      allow get, list: if admin() || (resource.data.status == 'Published' && resource.data.reviewed == true);
      allow create, update, delete: if admin();
    }
  }
}
