rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid))
        && get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.status == 'approved';
    }
    function owner() {
      return admin()
        && get(/databases/$(database)/documents/accessRequests/$(request.auth.uid)).data.get('role', 'editor') == 'owner';
    }
    match /accessRequests/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || owner();
      allow list: if owner();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'requestedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'requestedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if owner()
        && request.auth.uid != uid
        && resource.data.status == 'pending'
        && resource.data.get('role', 'editor') != 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.role == 'editor'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /hadiths/{id} {
      allow get, list: if admin() || (resource.data.status == 'Published' && resource.data.reviewed == true);
      allow create, update, delete: if admin();
    }
  }
}
